{
  "name": "@oversells/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.6",
    "@prisma/client": "^6.19.3",
    "archiver": "^8.0.0",
    "dockerode": "^5.0.1",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.6",
    "tar-stream": "^3.2.2",
    "zod": "^4.6.7",
    "@oversells/shared": "*",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/dockerode": "^4.0.2",
    "@types/node": "^26.6.5",
    "@types/tar-stream": "^3.1.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
