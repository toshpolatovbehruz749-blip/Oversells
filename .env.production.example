# Copy to .env.production, fill in, and keep it secret (never commit it).
OVERSELLS_DOMAIN=oversells.example.uz
ACME_EMAIL=admin@example.uz
ADMIN_EMAILS=admin@example.uz

# Generate each secret with: openssl rand -hex 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=
S3_ACCESS_KEY_ID=oversells
S3_SECRET_ACCESS_KEY=
# For Prometheus (Authorization: Bearer ...); leave empty to disable /metrics.
METRICS_TOKEN=

APP_REPLICAS=2
WORKER_REPLICAS=1
COMPILE_CONCURRENCY=2

# E-mail (password reset); without SMTP_HOST mails are only logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Oversells <no-reply@example.uz>

# AI assistance (off unless enabled).
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=30
