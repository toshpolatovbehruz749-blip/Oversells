# Copy to .env and adjust. docker compose reads it automatically;
# `npm run dev` (local development) reads it too.

# --- docker compose ----------------------------------------------------------
POSTGRES_USER=oversells
POSTGRES_PASSWORD=oversells
POSTGRES_DB=oversells
APP_PORT=3000
DB_PORT=5432

# --- server --------------------------------------------------------------------
# Used by local development and the tests (tests use <db>_test automatically).
# Inside docker compose this is overridden to point at the "db" service.
DATABASE_URL=postgresql://oversells:oversells@localhost:5432/oversells
PORT=3000
LOG_LEVEL=info
# Where file contents and PDFs are stored (local disk storage).
DATA_DIR=./data

# Limits
MAX_UPLOAD_BYTES=20971520
MAX_TEXT_FILE_BYTES=2097152
MAX_PROJECT_BYTES=209715200
MAX_FILES_PER_PROJECT=500

# --- compile sandbox -------------------------------------------------------------
COMPILE_IMAGE=oversells-texlive:latest
COMPILE_TIMEOUT_MS=60000
COMPILE_MEMORY_MB=1024
COMPILE_CPUS=1
COMPILE_WORKDIR_MB=512
COMPILE_CONCURRENCY=2
COMPILE_KEEP_OUTPUTS=5
# Docker Engine endpoint (default: the local socket).
DOCKER_SOCKET=/var/run/docker.sock
# DOCKER_HOST=tcp://127.0.0.1:2375
