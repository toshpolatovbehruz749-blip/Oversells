# Copy to .env and adjust. docker compose reads it automatically;
# `npm run dev` (local development) reads it too.

# --- docker compose ----------------------------------------------------------
POSTGRES_USER=oversells
POSTGRES_PASSWORD=oversells
POSTGRES_DB=oversells
APP_PORT=3000
DB_PORT=5432

# --- server --------------------------------------------------------------------
# Used by local development and the tests (tests use <db>_test automatically).
# Inside docker compose this is overridden to point at the "db" service.
DATABASE_URL=postgresql://oversells:oversells@localhost:5432/oversells
PORT=3000
LOG_LEVEL=info
# Where file contents and PDFs are stored (local disk storage).
DATA_DIR=./data

# Limits
MAX_UPLOAD_BYTES=20971520
MAX_TEXT_FILE_BYTES=2097152
MAX_PROJECT_BYTES=209715200
MAX_FILES_PER_PROJECT=500

# --- compile sandbox -------------------------------------------------------------
COMPILE_IMAGE=oversells-texlive:latest
COMPILE_TIMEOUT_MS=60000
COMPILE_MEMORY_MB=1024
COMPILE_CPUS=1
COMPILE_WORKDIR_MB=512
COMPILE_CONCURRENCY=2
COMPILE_KEEP_OUTPUTS=5
# Docker Engine endpoint (default: the local socket).
DOCKER_SOCKET=/var/run/docker.sock
# DOCKER_HOST=tcp://127.0.0.1:2375

# --- accounts (Phase 2) -----------------------------------------------------------
# Public address of the app; used in password reset e-mails.
APP_URL=http://localhost:3000
# Set to true when the app is served over HTTPS (Secure cookies).
COOKIE_SECURE=false
# Set to true only behind a trusted reverse proxy (uses X-Forwarded-For for rate limits).
TRUST_PROXY=false
SESSION_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=60
# Login/register/password-reset attempts per IP and window.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
# Projects created before accounts existed belong to a placeholder user.
# Set both to give that account your e-mail and password on the next start
# (if the e-mail already has an account, the projects are moved there).
# DEFAULT_OWNER_EMAIL=you@example.uz
# DEFAULT_OWNER_PASSWORD=change-me-please

# --- e-mail -----------------------------------------------------------------------
# Without SMTP_HOST, e-mails (password reset links) are written to the server log.
# SMTP_HOST=smtp.example.uz
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=Oversells <no-reply@localhost>

# Generate template preview images at start-up (needs the compiler image).
TEMPLATE_PREVIEWS_WARMUP=true

# --- real-time editing (Phase 3) ----------------------------------------------------
# Batch Yjs updates for this long before writing them to PostgreSQL.
COLLAB_PERSIST_DEBOUNCE_MS=300
# Write the plain text to file storage this long after the last change.
COLLAB_STORAGE_DEBOUNCE_MS=1000
# Replace a file's update log with one snapshot after this many batches.
COLLAB_COMPACT_AFTER=100
# Keep a document in memory this long after the last person left.
COLLAB_UNLOAD_AFTER_MS=30000
# Minimum time between automatic versions while people are editing (10 min).
AUTO_VERSION_INTERVAL_MS=600000

# --- AI assistance (Phase 4) ---------------------------------------------------------
# Off by default. While false, no request is ever sent to the AI provider.
AI_ENABLED=false
# Claude API key (https://console.anthropic.com). Required when AI_ENABLED=true.
ANTHROPIC_API_KEY=
# Optional: a proxy / gateway in front of the API (also used by the tests' mock).
# ANTHROPIC_BASE_URL=
AI_MODEL=claude-opus-5-5
# AI requests per user and day (UTC); admins can change it per user.
AI_DAILY_LIMIT=30
AI_TIMEOUT_MS=120000
